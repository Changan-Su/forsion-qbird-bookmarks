{
  "id": "bluebird",
  "name": {
    "zh": "青鸟收藏夹",
    "en": "Bluebird"
  },
  "icon": "video",
  "iconFile": "icon.png",
  "version": "2.4.0",
  "layout": {
    "main": [
      {
        "type": "plugin:bluebird:folder",
        "params": {
          "nativeWorkbench": true
        }
      }
    ],
    "left": [
      {
        "type": "workspace",
        "params": {
          "mode": "plugin:bluebird:library-list"
        }
      }
    ]
  },
  "requires": {
    "views": [
      "plugin:bluebird:folder"
    ]
  }
}
